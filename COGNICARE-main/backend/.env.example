PORT=5000
MONGO_URI=mongodb://localhost:27017/dementiacare
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Firebase Admin SDK Configuration
# Project: cognicare-5f5b4
# Download serviceAccountKey.json from Firebase Console:
# Project Settings > Service Accounts > Generate New Private Key
FIREBASE_PROJECT_ID=cognicare-5f5b4
FIREBASE_PROJECT_NAME=cognicare-5f5b4
FIREBASE_STORAGE_BUCKET=cognicare-5f5b4.firebasestorage.app

# Service Account Key Path (relative to backend root or absolute)
# For development: place firebaseServiceAccountKey.json in backend root
# For production: use FIREBASE_SERVICE_ACCOUNT_KEY environment variable with JSON content
FIREBASE_SERVICE_ACCOUNT_KEY=./firebaseServiceAccountKey.json

# Firebase Cloud Messaging (for push notifications)
# Get from Firebase Console > Project Settings > Cloud Messaging > Server Key
FIREBASE_FCM_SERVER_KEY=your-fcm-server-key

# HIPAA Compliance: Data Encryption
# Generate a strong 64-character hex key: openssl rand -hex 32
# Current key is for development only - must be changed for production
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Optional: Enable Firebase Emulator for local development
# Uncomment to use: FIREBASE_EMULATOR_HOST=127.0.0.1:9099

# Rate Limiting & Caching Configuration
# For production multi-instance deployments, provide Redis URL
# Format: redis://[:password@]host:port/[database]
# If not provided, uses in-memory store (suitable for single instance dev)
REDIS_URL=redis://localhost:6379

# Application Security
# CORS allowed origins (comma-separated for multiple)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT/Session Configuration
# Session timeout in milliseconds (24 hours = 86400000)
SESSION_TIMEOUT=86400000

# API Rate Limiting (requests per 15 minutes)
RATE_LIMIT_AUTH=5
RATE_LIMIT_API=100
RATE_LIMIT_SENSITIVE=3
