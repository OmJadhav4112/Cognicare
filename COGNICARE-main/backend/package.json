{
  "name": "dementiacare-backend",
  "version": "1.0.0",
  "description": "DementiaCare+ backend API server",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --detectOpenHandles --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --forceExit"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.19.2",
    "express-rate-limit": "7.1.5",
    "express-validator": "7.1.0",
    "firebase-admin": "12.0.0",
    "helmet": "7.1.0",
    "json2csv": "5.0.7",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "8.4.1",
    "morgan": "1.10.0",
    "multer": "1.4.4",
    "node-schedule": "2.1.1",
    "pdfkit": "0.13.0",
    "sharp": "0.33.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.1.6",
    "nodemon": "3.1.3",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js",
      "!src/config/**",
      "!src/utils/db.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 50,
        "functions": 50,
        "lines": 50,
        "statements": 50
      }
    },
    "testMatch": [
      "**/__tests__/**/*.test.js",
      "**/*.test.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/src/__tests__/setup.js"
    ]
  }
}
